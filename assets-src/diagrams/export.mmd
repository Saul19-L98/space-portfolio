flowchart LR
  U([User<br/>Export button or table console])
  G["Front door<br/>API Gateway"]
  L["Export service<br/>Lambda (FastAPI)"]
  Q[["Job queue<br/>SQS (up to 10 at a time)"]]
  W["Worker<br/>Lambda"]
  AT["Data query<br/>Athena + Glue catalogue"]
  S3[("Data and files<br/>S3: imports / exports")]
  DY[("Job state<br/>DynamoDB")]
  DL[["Error queue<br/>retries exhausted"]]
  H["ERP source (SAP HANA Cloud)<br/>scheduled load 3× a day"]
  U -- "1. request" --> G --> L
  L -- "2. enqueue" --> Q
  L -- "record" --> DY
  Q --> W
  W -- "3. query" --> AT --> S3
  W -- "4. store file (90 days)" --> S3
  W -- "update state" --> DY
  Q -. "3 failed attempts" .-> DL
  H -- "ETL" --> S3
  S3 -- "5. temporary download link" --> U
  U -. "poll state every 5 s" .-> DY
